LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma2:27b
LLM_TEMPERATURE=0.0

# ── Runtime tuning ────────────────────────────────────────────
NER_USE_GPU=0                 # containers run CPU-only unless you add GPU support
HF_NER_ENABLED=true
# COREF_SERVICE_URL=http://...  # optional; if omitted, coref degrades gracefully
# COREF_REQUIRED unset          # leave unset so a missing coref service won't hard-fail

# ── Optional API keys (higher rate limits for PubMed/PMC) ─────
# PUBMED_API_KEY=